{
  "name": "unit-test",
  "version": "1.0.0",
  "description": "Unit test suite with Jest, GitHub Actions and SonarCloud",
  "main": "index.js",
  "author": "Gustavo Dias",
  "license": "ISC",
  "dependencies": {
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "mkdirp": "^3.0.1"
  },
  "scripts": {
    "clean": "rimraf ./coverage && mkdirp ./coverage",
    "test": "npm run clean && jest",
    "coverage": "npm run clean && jest --coverage"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  }
}
